      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Toolbar and panel action with pictogram and shortcut key cap.",
      "html": "<button class=\"ds-btn\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"6\" cy=\"6\" r=\"3\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><path d=\"M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12\"/></svg>Kesim <kbd class=\"ds-kbd\">K</kbd></button>",
      "css": ".ds-btn{font-family:\"Atkinson Hyperlegible Next\",\"Segoe UI\",system-ui,sans-serif;font-variant-numeric:tabular-nums;font-size:15px;display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 12px;border-radius:6px;border:1px solid #8d9bb0;background:#ffffff;color:#15202e;cursor:pointer;}.ds-btn:hover{background:#eef2f7;}.ds-btn:focus-visible{outline:3px solid #0b5cd5;outline-offset:2px;}.ds-kbd{font:inherit;font-size:13px;font-weight:600;color:#44526a;border:1px solid #cdd6e2;border-radius:4px;padding:0 5px;}"
    },
