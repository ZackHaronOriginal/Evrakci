      "css": ".ds-btn-primary{font-family:\"Atkinson Hyperlegible Next\",\"Segoe UI\",system-ui,sans-serif;font-variant-numeric:tabular-nums;font-size:15px;display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 12px;border-radius:6px;border:1px solid #13294b;background:#13294b;color:#fff;cursor:pointer;}.ds-btn-primary:hover{background:#1d3a66;}.ds-btn-primary:focus-visible{outline:3px solid #0b5cd5;outline-offset:2px;}.ds-kbd-n{font:inherit;font-size:13px;font-weight:600;color:#c6d3e8;border:1px solid #1d3a66;border-radius:4px;padding:0 5px;}"
    },
